{
  "name": "hersafe-qa",
  "version": "0.1.0",
  "private": true,
  "description": "她测 HerSafe QA — 女性友好与安全情境审查工具（Next.js 15 全栈）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "e2e": "playwright test",
    "postinstall": "playwright install chromium && prisma generate"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@prisma/client": "^6.16.2",
    "@rive-app/react-canvas": "^4.32.1",
    "adm-zip": "^0.6.0",
    "animejs": "^4.5.0",
    "lucide-react": "^1.34.0",
    "mammoth": "^1.9.0",
    "next": "^15.5.4",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.49.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.1",
    "tesseract.js": "^5.1.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.49.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
