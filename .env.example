# 复制为 .env 并填入真实值。API Key 只保存在后端环境变量，不进入前端与代码仓库（PRD §7.2）
DATABASE_URL="file:dev.db"
# 阶跃星辰 StepFun（OpenAI 兼容接口；pro plan 专属网关）。用户项目进行模型分析时必须配置；留空会明确报错，不生成模拟结论
STEPFUN_API_KEY=""
STEP_BASE_URL="https://api.stepfun.com/step_plan/v1"
STEP_MODEL="step-3.7-flash"
STEP_TEXT_MODEL="step-3.5-flash-2603"

MAX_IMAGES=12
MAX_PDF_PAGES=20
MAX_PDF_MB=50
MAX_DOC_MB=5
MAX_IMG_MB=10

# 可选：Playwright 网站抓取走指定代理（如 http://127.0.0.1:7897）；不设则强制直连（避免继承系统残留代理）
PROXY_URL=""
